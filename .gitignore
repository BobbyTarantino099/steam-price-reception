# Crudo de Steam (~400 MB) - excede lo razonable para un repo de portafolio.
# Descargar desde: https://www.kaggle.com/datasets/fronkongames/steam-games-dataset
datos/crudos/steam_fronkongames_catalogo-historico_*.csv

# Datos limpios (~75 MB): son derivados, no fuentes.
# Se regeneran con `python notebooks/procesar.py` a partir del crudo.
datos/limpios/

# Basura de SO / entornos
.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints/
node_modules/

# Video (video/README.md) -------------------------------------------------------
# The voice recordings are personal and stay off the public repo; everything built
# from them is derived. The published video lives on YouTube.
video/voz*.wav
video/composicion/voz_limpia.wav
video/composicion/mezcla.wav
video/composicion/transcript.json
# Music: its licence allows using it inside a video, not redistributing the file.
video/musica_*.mp3
# Renders are outputs; regenerate with `npm run render` in video/composicion/.
video/composicion/renders/
# Agent instructions that `hyperframes init` writes into every project. They are the
# tool's generic boilerplate, regenerated by the same command (see video/README.md).
video/composicion/CLAUDE.md
video/composicion/AGENTS.md
